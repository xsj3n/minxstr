cabal-version:      3.0
name:               Minxstr
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             xsj3n
maintainer:         ""
-- copyright:
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- embedded into the binary by Minxstr.Queries at compile time
extra-source-files: queries/**/*.sql

common warnings
    ghc-options: -Wall

library
    exposed-modules: Minxstr.PKI,
                     Minxstr.DataSchema,
                     Minxstr.Poll,
                     Minxstr.DatabaseInterface,
                     Minxstr.Registration,
                     Minxstr.TLS,
                     Minxstr.Log,
                     Minxstr.Configuration,
                     Minxstr.Queries

    hs-source-dirs: src

    build-depends:  mtl,
                    exceptions,
                    stm,
                    filepath,
                    generic-data,
                    aeson,
                    directory,
                    string-interpolate,
                    postgresql-simple,
                    crypton,
                    pem,
                    crypton-x509,
                    crypton-x509-validation,
                    crypton-x509-store,
                    bytestring,
                    uuid,
                    process,
                    text,
                    http-types,
                    zlib,
                    ram,
                    extra,
                    warp,
                    warp-tls,
                    tls,
                    wai,
                    network,
                    time,
                    tomland,
                    file-embed,
                    base

    default-language: GHC2024

executable Minxstr
    import:           warnings
    main-is:          Main.hs
    
    build-depends:  base,
                    aeson,
                    directory,
                    string-interpolate,
                    postgresql-simple,
                    crypton,
                    pem,
                    crypton-x509,
                    crypton-x509-validation,
                    crypton-x509-store,
                    bytestring,
                    uuid,
                    process,
                    text,
                    http-types,
                    zlib,
                    extra,
                    warp,
                    warp-tls,
                    tls,
                    wai,
                    network,
                    Minxstr


    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   app
    default-language: GHC2024

test-suite pki-test
    type: exitcode-stdio-1.0
    hs-source-dirs: tests/pki/
    main-is: Test.hs
    build-depends: base,
                   extra,
                   directory,
                   crypton-x509-validation,
                   Minxstr
    default-language: GHC2024

test-suite log-test
    type: exitcode-stdio-1.0
    hs-source-dirs: tests/log/
    main-is: Test.hs
    build-depends: base,
                   Minxstr
    default-language: GHC2024
